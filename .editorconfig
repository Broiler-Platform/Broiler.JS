root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true
indent_style = space

[*.{cs,csx}]
indent_size = 4
# Keep file-scoped namespaces and var usage consistent with the codebase.
csharp_style_namespace_declarations = file_scoped:suggestion
dotnet_sort_system_directives_first = true

[*.{csproj,props,targets,xml,yml,yaml,json,slnx}]
indent_size = 2

# Generated lookup tables: never report style/whitespace findings on this file.
[**/Generated/*.g.cs]
generated_code = true
dotnet_analyzer_diagnostic.severity = none

[*.{txt,md}]
trim_trailing_whitespace = false
