<Project>
  <PropertyGroup>
    <ManagePackageVersionsCentrally>true</ManagePackageVersionsCentrally>
  </PropertyGroup>

  <PropertyGroup>
    <!--
      One Roslyn version for the compiler toolset and the APIs built against it: the
      JSClassGenerator source generator only loads in a compiler at least as new as the
      Roslyn it references (see Directory.Build.props), so these move together.
    -->
    <RoslynVersion>5.3.0</RoslynVersion>
    <NuGetClientLibrariesVersion>7.3.1</NuGetClientLibrariesVersion>
  </PropertyGroup>

  <ItemGroup>
    <!-- Broiler component packages -->
    <PackageVersion Include="Broiler.Regex" Version="0.1.0-preview.3" />
    <PackageVersion Include="Broiler.Unicode.Cldr.LocaleData" Version="0.1.0-preview.2" />

    <!-- Compiler and build tooling -->
    <PackageVersion Include="Microsoft.Net.Compilers.Toolset" Version="$(RoslynVersion)" />
    <PackageVersion Include="Microsoft.CodeAnalysis.CSharp" Version="$(RoslynVersion)" />
    <PackageVersion Include="Microsoft.CodeAnalysis.CSharp.Scripting" Version="$(RoslynVersion)" />
    <PackageVersion Include="Nerdbank.GitVersioning" Version="3.9.50" />

    <!-- Runtime dependencies -->
    <PackageVersion Include="Microsoft.Extensions.DependencyModel" Version="10.0.7" />
    <PackageVersion Include="NuGet.Client" Version="4.2.0" />
    <PackageVersion Include="NuGet.Protocol" Version="$(NuGetClientLibrariesVersion)" />
    <PackageVersion Include="NuGet.Resolver" Version="$(NuGetClientLibrariesVersion)" />

    <!-- Benchmarks and tests -->
    <PackageVersion Include="BenchmarkDotNet" Version="0.14.0" />
    <PackageVersion Include="coverlet.collector" Version="6.0.0" />
    <PackageVersion Include="Microsoft.NET.Test.Sdk" Version="17.8.0" />
    <PackageVersion Include="xunit" Version="2.5.3" />
    <PackageVersion Include="xunit.runner.visualstudio" Version="2.5.3" />
  </ItemGroup>
</Project>
