prov: ref:unicoderef@1 ucd:17.0.0/WordBreakProperty.txt ucd:17.0.0/PropList.txt ucd:17.0.0/Scripts.txt
script: Array.from(new Intl.Segmenter("en", { granularity: "word" }).segment("_\u0308\u05D0"), function (s) { return s.isWordLike ? "Y" : "N"; }).join("")
