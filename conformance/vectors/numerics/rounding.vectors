id: numerics/duration-total/0001
area: numerics
op: Temporal.Duration.prototype.total
in: bigint:1 str:"nanosecond"
out: value: f64:0x3FF0000000000000
class: normative
prov: ref:numericsref@1
script: Temporal.Duration.from({seconds: 0, nanoseconds: 1}).total("nanosecond")
note: the Number nearest the exact quotient by the unit's length, ties to even (TotalTimeDuration, Temporal proposal)
since: 6

