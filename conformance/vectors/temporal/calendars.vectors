script: (function (r) { var n = Temporal.PlainDate.from({calendar: "hebrew", year: 5784, month: 1, day: 1}).monthsInYear; for (var m = 1; m <= n; m++) r.push(Temporal.PlainDate.from({calendar: "hebrew", year: 5784, month: m, day: 1}).monthCode); return r.join(); })([])
