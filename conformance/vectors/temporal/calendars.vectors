script: (function (d) { return d.year + "/" + d.monthCode + "/" + d.day + ";" + d.month + ";" + d.toString({calendarName: "never"}); })(Temporal.PlainDate.from({calendar: "islamic-umalqura", year: 1445, monthCode: "M00", day: 1}, {overflow: "constrain"}))
note: rows C4 and C5: month codes in each calendar's leap year under both overflows (the grammar's MonthCode, then Table 3's validity: an invalid code is a RangeError under constrain too)
since: 24

