op: CalendarISOToDate, a year's structure
in: str:"chinese" int:1900
out: value: str:"1900-01-31;384;13;slsslsllsllsl;M08L@9"
class: normative
prov: proposal:temporal@e8cc03fc#sec-temporal-calendarisotodate proposal:intl-era-monthcode@5833eae#table-calendar-types ref:temporalref@1
script: (function (first, r, leap) { for (var m = 1; m <= first.monthsInYear; m++) { var d = Temporal.PlainDate.from({calendar: "chinese", year: 1900, month: m, day: 1}); r.push(d.daysInMonth === 30 ? "l" : d.daysInMonth === 29 ? "s" : String(d.daysInMonth)); if (d.monthCode.length === 4) leap.push(d.monthCode + "@" + m); } return first.toString({calendarName: "never"}) + ";" + first.daysInYear + ";" + first.monthsInYear + ";" + r.join("") + ";" + leap.join(); })(Temporal.PlainDate.from({calendar: "chinese", year: 1900, month: 1, day: 1}), [], [])
note: row C18: the table calendars at their tables' edges where Table 1 publishes them (chinese 1900 to 2100, dangi 1900 to 2050, Umm al-Qura 1300 to 1600 AH and islamic-civil outside them, persian 1206 to 1498 AP): new year, length, months and leap month
since: 24

