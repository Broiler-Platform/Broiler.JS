out: value: str:"P1Y"
class: normative
prov: proposal:temporal@e8cc03fc#sec-temporal.duration.prototype.round proposal:temporal@e8cc03fc#sec-temporal-roundrelativeduration ref:temporalref@1
script: Temporal.Duration.from({months: 10, days: 30}).round({smallestUnit: "month", largestUnit: "year", roundingMode: "ceil", relativeTo: new Temporal.PlainDate(2019, 3, 31)}).toString()
