id: regexp/case-insensitive/m2a-back-references/0001
area: regexp
op: RegExpBuiltinExec
in: str:"(I)\\1" str:"i" str:"I\u0130" int:0
out: value: str:"lastIndex=0;null"
class: divergence
divergence.broiler-js: row M2a: the dotted and dotless i, i and I against U+0130 and U+0131, in literals, classes and back-references, without u; Broiler.JS answers, under tr-TR, true for i and U+0130 and for I and U+0131, and under lt-LT true for i and I against U+0130, with the negated classes false: RegexOptions.IgnoreCase without CultureInvariant reads .NET's current culture; under the invariant culture it answers as Canonicalize does, and a run there reports the field as no longer holding; a correction of Broiler.JS (JSD-0081; decision D33, its bundle sjl-11-001's part D); answered by SJL-11.5, Broiler.JS's cut-over to Broiler.Regex
prov: spec:es2026@0248456c#sec-regexpbuiltinexec spec:es2026@0248456c#sec-compilepattern spec:es2026@0248456c#sec-compilesubpattern spec:es2026@0248456c#sec-backreference-matcher spec:es2026@0248456c#sec-runtime-semantics-canonicalize-ch ref:regexpref@1 ucd:17.0.0/UnicodeData.txt ucd:17.0.0/SpecialCasing.txt
script: function $s(v) { return v === undefined ? "u" : v.length + ":" + v; } function $p(v) { return v === undefined ? "u" : v[0] + "-" + v[1]; } function $g(o, f) { if (o === undefined) return "u"; var k = Object.keys(o), t = "" + k.length; for (var j = 0; j < k.length; j++) t += ";<" + k[j] + ">=" + f(o[k[j]]); return t; } function $x(r, m) { var t = "lastIndex=" + r.lastIndex; if (m === null) return t + ";null"; t += ";index=" + m.index + ";length=" + m.length; for (var i = 0; i < m.length; i++) t += ";" + i + "=" + $s(m[i]); t += ";groups=" + $g(m.groups, $s); if (m.indices === undefined) return t + ";indices=u"; t += ";indices=" + m.indices.length; for (var j = 0; j < m.indices.length; j++) t += ";" + j + "=" + $p(m.indices[j]); return t + ";igroups=" + $g(m.indices.groups, $p); } var r = new RegExp("(I)\\1", "i"); r.lastIndex = 0; $x(r, r.exec("I\u0130"))
note: correspondence row M2a: a back-reference canonicalizes both sides
since: 31

