class: impl-defined
per-engine.broiler-js: value: str:"lastIndex=0;index=0;length=1;0=0:;groups=u;indices=u"
per-engine.broiler-vm: value: str:"lastIndex=0;index=0;length=1;0=0:;groups=u;indices=u"
prov: spec:es2026@0248456c#sec-regexpbuiltinexec spec:es2026@0248456c#sec-getmatchstring
script: function $s(v) { return v === undefined ? "u" : v.length + ":" + v; } function $p(v) { return v === undefined ? "u" : v[0] + "-" + v[1]; } function $g(o, f) { if (o === undefined) return "u"; var k = Object.keys(o), t = "" + k.length; for (var j = 0; j < k.length; j++) t += ";<" + k[j] + ">=" + f(o[k[j]]); return t; } function $x(r, m) { var t = "lastIndex=" + r.lastIndex; if (m === null) return t + ";null"; t += ";index=" + m.index + ";length=" + m.length; for (var i = 0; i < m.length; i++) t += ";" + i + "=" + $s(m[i]); t += ";groups=" + $g(m.groups, $s); if (m.indices === undefined) return t + ";indices=u"; t += ";indices=" + m.indices.length; for (var j = 0; j < m.indices.length; j++) t += ";" + j + "=" + $p(m.indices[j]); return t + ";igroups=" + $g(m.indices.groups, $p); } var r = new RegExp("(?:)", "gu"); r.lastIndex = 1; $x(r, r.exec("\ud834\udf06"))
note: correspondence row M4: the empty match from a lastIndex inside a surrogate pair under u: RegExpBuiltinExec's Match Record would start at 1 and end at 0, which GetMatchString's assertion forbids, so the text has no answer and regexpref gives none; JSD-0081's decision D41 classes the case implementation-defined until the text is corrected, and records each engine's answer, Broiler.VM index 0 and lastIndex 0, Broiler.JS index 1 and lastIndex 1, which are the per-engine expectations; out lists both. Revision 32: Broiler.JS's answer is index 0 and lastIndex 0, Broiler.VM's, since its u patterns went to Broiler.Regex 0.1.0-preview.5 (a58d31d1), as D41's dated note of 2026-11-01 (owner's decision D-p5) records, so its per-engine expectation is that answer; out still lists both answers D41 has recorded
since: 31

