script: function $s(v) { return v === undefined ? "u" : v.length + ":" + v; } function $p(v) { return v === undefined ? "u" : v[0] + "-" + v[1]; } function $g(o, f) { if (o === undefined) return "u"; var k = Object.keys(o), t = "" + k.length; for (var j = 0; j < k.length; j++) t += ";<" + k[j] + ">=" + f(o[k[j]]); return t; } function $x(r, m) { var t = "lastIndex=" + r.lastIndex; if (m === null) return t + ";null"; t += ";index=" + m.index + ";length=" + m.length; for (var i = 0; i < m.length; i++) t += ";" + i + "=" + $s(m[i]); t += ";groups=" + $g(m.groups, $s); if (m.indices === undefined) return t + ";indices=u"; t += ";indices=" + m.indices.length; for (var j = 0; j < m.indices.length; j++) t += ";" + j + "=" + $p(m.indices[j]); return t + ";igroups=" + $g(m.indices.groups, $p); } var r = new RegExp("(?:a|ab)*c", ""); r.lastIndex = 0; $x(r, r.exec("ababababababababababababababababababababababababababababababababababababababababababababababababababc".repeat(1) + ""))
note: correspondence row B6: a loop of alternatives: regexpref's count is 913, at most a hundredth of the budget of 1000000, so the library completes with the answer; a library-level vector (decision D25), which engine-level runners evaluate too, as the exec without a budget, since only a status vector is skipped (revision 32)
