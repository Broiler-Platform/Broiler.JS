script: var get = Object.getOwnPropertyDescriptor(RegExp.prototype, "flags").get, seen = [], o = {}; ["hasIndices", "global", "ignoreCase", "multiline", "dotAll", "unicode", "unicodeSets", "sticky"].forEach(function (k) { Object.defineProperty(o, k, { get: function () { seen.push(k); return false; } }); }); get.call(o); seen.join()
