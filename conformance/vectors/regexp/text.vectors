script: var s = new RegExp("[/]", "").source; [s.indexOf("\n"), s.indexOf("\r"), s.indexOf("\u2028"), s.indexOf("\u2029")].join() === "-1,-1,-1,-1" && (0, eval)("/" + s + "/").test("/") === true
