script: function $n(r, m) { var t = "lastIndex=" + r.lastIndex; if (m === null) return t + ";null"; t += ";index=" + m.index + ";length=" + m.length; for (var i = 0; i < m.length; i++) t += ";" + i + "=" + (m[i] === undefined ? "u" : m[i].length); return t; } var r = new RegExp("(?:(a)(b)(c))*".repeat(1) + "", ""); r.lastIndex = 0; $n(r, r.exec("abc".repeat(161000) + ""))
