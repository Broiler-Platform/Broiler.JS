id: regexp/matching/s10-lead-surrogate-escapes/0001
area: regexp
op: RegExpBuiltinExec
in: str:"\\uD83D\\u{DC38}+" str:"u" str:"\uD83D\uDC38\uDC38" int:0
out: value: str:"lastIndex=0;null"
class: divergence
divergence.broiler-vm: row S10: under u or v, a four-digit lead-surrogate escape before a braced escape, \uD83D\u{DC38}, \uD83D\u{3042}, [\uD83D\u{3042}], [\uD83D\u{DC38}]; Broiler.VM answers a SyntaxError ("Invalid escape"), early: after a four-digit lead escape a following \u commits to four hexadecimal digits (F/JsRegExpMatcher.cs:3440-3458 at aaa39fb), which throws on {; a correction of Broiler.VM (kind R, JSD-0081); answered by SJL-11.4, Broiler.VM's cut-over to Broiler.Regex
prov: spec:es2026@0248456c#sec-regexpbuiltinexec spec:es2026@0248456c#sec-compilepattern spec:es2026@0248456c#sec-compilesubpattern spec:es2026@0248456c#sec-runtime-semantics-repeatmatcher-abstract-operation spec:es2026@0248456c#sec-getstringindex ref:regexpref@1
script: function $s(v) { return v === undefined ? "u" : v.length + ":" + v; } function $p(v) { return v === undefined ? "u" : v[0] + "-" + v[1]; } function $g(o, f) { if (o === undefined) return "u"; var k = Object.keys(o), t = "" + k.length; for (var j = 0; j < k.length; j++) t += ";<" + k[j] + ">=" + f(o[k[j]]); return t; } function $x(r, m) { var t = "lastIndex=" + r.lastIndex; if (m === null) return t + ";null"; t += ";index=" + m.index + ";length=" + m.length; for (var i = 0; i < m.length; i++) t += ";" + i + "=" + $s(m[i]); t += ";groups=" + $g(m.groups, $s); if (m.indices === undefined) return t + ";indices=u"; t += ";indices=" + m.indices.length; for (var j = 0; j < m.indices.length; j++) t += ";" + j + "=" + $p(m.indices[j]); return t + ";igroups=" + $g(m.indices.groups, $p); } var r = new RegExp("\\uD83D\\u{DC38}+", "u"); r.lastIndex = 0; $x(r, r.exec("\ud83d\udc38\udc38"))
note: correspondence row S10: a braced escape never joins a pair, so each pattern holds a lone lead surrogate
since: 31

