script: function $s(v) { return v === undefined ? "u" : v.length + ":" + v; } function $p(v) { return v === undefined ? "u" : v[0] + "-" + v[1]; } function $g(o, f) { if (o === undefined) return "u"; var k = Object.keys(o), t = "" + k.length; for (var j = 0; j < k.length; j++) t += ";<" + k[j] + ">=" + f(o[k[j]]); return t; } function $x(r, m) { var t = "lastIndex=" + r.lastIndex; if (m === null) return t + ";null"; t += ";index=" + m.index + ";length=" + m.length; for (var i = 0; i < m.length; i++) t += ";" + i + "=" + $s(m[i]); t += ";groups=" + $g(m.groups, $s); if (m.indices === undefined) return t + ";indices=u"; t += ";indices=" + m.indices.length; for (var j = 0; j < m.indices.length; j++) t += ";" + j + "=" + $p(m.indices[j]); return t + ";igroups=" + $g(m.indices.groups, $p); } var r = new RegExp("[\\uD83D\\uDC38]", "u"); r.lastIndex = 0; $x(r, r.exec("\ud83d\udc38"))
note: correspondence row S10: a braced escape never joins a pair, so each pattern holds a lone lead surrogate
since: 31

