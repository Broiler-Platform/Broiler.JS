id: regexp/matching/s1-duplicate-names/0001
area: regexp
op: RegExpBuiltinExec
in: str:"(?<a>x)|(?<a>y)" str:"" str:"y" int:0
out: value: str:"lastIndex=0;index=0;length=3;0=1:y;1=u;2=1:y;groups=1;<a>=1:y;indices=u"
class: divergence
divergence.broiler-vm: row S1: duplicate named groups across alternatives (ES2025), under none, d, u and v, with \k and three alternatives, by the constructor, a literal never evaluated and every exec form, and the escaped name of row S2a across alternatives; Broiler.VM answers a SyntaxError, early: the pre-scan refuses any repeated name, decoding escapes first (F/JsRegExpMatcher.cs:1592-1617 at aaa39fb); a correction of Broiler.VM (kind D, SJL-D-14 (i); JSD-0081); answered by SJL-11.4, Broiler.VM's cut-over to Broiler.Regex
prov: spec:es2026@0248456c#sec-regexpbuiltinexec spec:es2026@0248456c#sec-compilepattern spec:es2026@0248456c#sec-compilesubpattern ref:regexpref@1
script: function $s(v) { return v === undefined ? "u" : v.length + ":" + v; } function $p(v) { return v === undefined ? "u" : v[0] + "-" + v[1]; } function $g(o, f) { if (o === undefined) return "u"; var k = Object.keys(o), t = "" + k.length; for (var j = 0; j < k.length; j++) t += ";<" + k[j] + ">=" + f(o[k[j]]); return t; } function $x(r, m) { var t = "lastIndex=" + r.lastIndex; if (m === null) return t + ";null"; t += ";index=" + m.index + ";length=" + m.length; for (var i = 0; i < m.length; i++) t += ";" + i + "=" + $s(m[i]); t += ";groups=" + $g(m.groups, $s); if (m.indices === undefined) return t + ";indices=u"; t += ";indices=" + m.indices.length; for (var j = 0; j < m.indices.length; j++) t += ";" + j + "=" + $p(m.indices[j]); return t + ";igroups=" + $g(m.indices.groups, $p); } var r = new RegExp("(?<a>x)|(?<a>y)", ""); r.lastIndex = 0; $x(r, r.exec("y"))
note: correspondence row S1: groups and indices.groups read the participating group; \k reads it
since: 31

