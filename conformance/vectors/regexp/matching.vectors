id: regexp/matching/b1-greedy-run/0001
area: regexp
op: RegExpBuiltinExec, repeated inputs
in: str:"a*" int:1 str:"" str:"" str:"a" int:1048000 str:"" int:0
out: value: str:"lastIndex=0;index=0;length=1;0=1048000"
class: normative
prov: spec:es2026@0248456c#sec-regexpbuiltinexec spec:es2026@0248456c#sec-compilepattern spec:es2026@0248456c#sec-compilesubpattern spec:es2026@0248456c#sec-runtime-semantics-repeatmatcher-abstract-operation ref:regexpref@1
script: function $n(r, m) { var t = "lastIndex=" + r.lastIndex; if (m === null) return t + ";null"; t += ";index=" + m.index + ";length=" + m.length; for (var i = 0; i < m.length; i++) t += ";" + i + "=" + (m[i] === undefined ? "u" : m[i].length); return t; } var r = new RegExp("a*".repeat(1) + "", ""); r.lastIndex = 0; $n(r, r.exec("a".repeat(1048000) + ""))
note: correspondence row B1: a* over 1,048,000 characters: the whole input (inside the frame ceiling of decision D10, which Broiler.VM reaches past 2^20 characters, one frame each; row B1's b1h)
since: 31

