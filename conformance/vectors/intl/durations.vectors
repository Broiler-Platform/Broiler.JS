id: intl/durations/argument/0004
area: intl
op: Intl.DurationFormat.prototype.format
in: str:"en"
out: value: str:"1 hr"
class: divergence
divergence.broiler-js: row U7: A property bag as the argument: the reads of `format` and `formatToParts` through getters on all ten fields ...; Broiler.JS answers each field read twice, in table order (`get years, get months, ..., get nanoseconds`, then again): `ValidateDurationArgument` validates the first reads ...; a correction of Broiler.JS (JSD-0082, C1); answered by SJL-9.5, this engine's cut-over to the shared Intl library
prov: proposal:temporal@e8cc03fc#sec-temporal-totemporalpartialdurationrecord ref:intlref@1
script: (function () { var o = {}; var n = 0; Object.defineProperty(o, "hours", {get: function () { if (n++) throw new EvalError("second"); return 1; }}); return new Intl.DurationFormat("en").format(o); })()
