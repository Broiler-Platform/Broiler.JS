id: intl/durations/argument/0001
area: intl
op: Intl.DurationFormat.prototype.format
in: str:"en"
out: value: str:"get days,valueOf days,get hours,valueOf hours,get microseconds,valueOf microseconds,get milliseconds,valueOf milliseconds,get minutes,valueOf minutes,get months,valueOf months,get nanoseconds,valueOf nanoseconds,get seconds,valueOf seconds,get weeks,valueOf weeks,get years,valueOf years"
class: divergence
divergence.broiler-js: row U7: A property bag as the argument: the reads of `format` and `formatToParts` through getters on all ten fields ...; Broiler.JS answers each field read twice, in table order (`get years, get months, ..., get nanoseconds`, then again): `ValidateDurationArgument` validates the first reads ...; a correction of Broiler.JS (JSD-0082, C1); answered by SJL-9.5, this engine's cut-over to the shared Intl library
prov: proposal:temporal@e8cc03fc#sec-temporal-totemporalpartialdurationrecord spec:ecma402@3d4c558#sec-Intl.DurationFormat.prototype.format ref:intlref@1
script: (function () { var log = []; var o = {}; ["days", "hours", "microseconds", "milliseconds", "minutes", "months", "nanoseconds", "seconds", "weeks", "years"].forEach(function (k) { Object.defineProperty(o, k, {get: function () { log.push("get " + k); return {valueOf: function () { log.push("valueOf " + k); return 1; }}; }}); }); new Intl.DurationFormat("en").format(o); return log.join(); })()
note: row U7: each field read once, in alphabetical order, each converted as it is read
since: 27

id: intl/durations/argument/0002
area: intl
op: Intl.DurationFormat.prototype.format
in: str:"en"
out: value: str:"1 hr"
class: divergence
divergence.broiler-js: row U7: A property bag as the argument: the reads of `format` and `formatToParts` through getters on all ten fields ...; Broiler.JS answers each field read twice, in table order (`get years, get months, ..., get nanoseconds`, then again): `ValidateDurationArgument` validates the first reads ...; a correction of Broiler.JS (JSD-0082, C1); answered by SJL-9.5, this engine's cut-over to the shared Intl library
prov: proposal:temporal@e8cc03fc#sec-temporal-totemporalpartialdurationrecord ref:intlref@1
script: (function () { var o = {}; var n = 0; Object.defineProperty(o, "hours", {get: function () { return n++ ? -1 : 1; }}); return new Intl.DurationFormat("en").format(o); })()
note: row U7: a getter that answers 1 then -1 is read once
since: 27

id: intl/durations/argument/0003
area: intl
op: Intl.DurationFormat.prototype.format
in: str:"en"
out: value: str:"1 hr"
class: divergence
divergence.broiler-js: row U7: A property bag as the argument: the reads of `format` and `formatToParts` through getters on all ten fields ...; Broiler.JS answers each field read twice, in table order (`get years, get months, ..., get nanoseconds`, then again): `ValidateDurationArgument` validates the first reads ...; a correction of Broiler.JS (JSD-0082, C1); answered by SJL-9.5, this engine's cut-over to the shared Intl library
prov: proposal:temporal@e8cc03fc#sec-temporal-totemporalpartialdurationrecord ref:intlref@1
script: (function () { var o = {}; var n = 0; Object.defineProperty(o, "hours", {get: function () { return n++ ? 1.5 : 1; }}); return new Intl.DurationFormat("en").format(o); })()
