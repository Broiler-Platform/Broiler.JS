id: intl/numbers-and-text/options/0001
area: intl
op: Intl.NumberFormat (reads after construction)
in: str:"en"
out: value: f64:0x0000000000000000
class: divergence
divergence.broiler-js: row N10: Options read again after construction: a spied options bag through `format`, `formatToParts`, `formatRange` ...; Broiler.JS answers reads `style`, `currency`, `currencyDisplay`, `currencySign`, `unit` at each call; after mutation `"$1.00"`, `"100%"`, `"(EUR1.00)"` ...; a correction of Broiler.JS (JSD-0082, C1); answered by SJL-9.5, this engine's cut-over to the shared Intl library
prov: spec:ecma402@3d4c558#sec-intl.numberformat spec:ecma402@3d4c558#sec-intl.numberformat.prototype.format ref:intlref@1
script: (function () { var log = []; var o = {}; ["style", "currency", "currencyDisplay", "currencySign", "unit"].forEach(function (k) { Object.defineProperty(o, k, {get: function () { log.push(k); return k === "style" ? "currency" : k === "currency" ? "EUR" : undefined; }}); }); var f = new Intl.NumberFormat("en", o); log.length = 0; f.format(1); f.formatToParts(1); f.formatRange(1, 2); f.resolvedOptions(); return log.length; })()
note: row N10: no option is read after construction
since: 27

