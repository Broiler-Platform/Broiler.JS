script: var t = new Uint8Array(2); t["1e-7"] = 7; (t["1e-7"] === 7 ? 10 : 0) + Object.keys(t).length
note: 12: a valid integer index; 13: not canonical, an ordinary property; 2: canonical, not an index
since: 1

id: numbers/array-index/0029
