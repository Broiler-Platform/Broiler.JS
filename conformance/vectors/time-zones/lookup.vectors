id: time-zones/offset-id/0060
area: time-zones
op: GetPossibleEpochNanoseconds
in: str:"-12:00" int:2020 int:1 int:1 int:0 int:0 int:0
out: value: str:"1577880000000000000"
class: normative
prov: spec:es2026@0248456c#sec-time-zone-identifiers spec:es2026@0248456c#sec-getnamedtimezoneepochnanoseconds ref:tzref@1
script: var w = new Temporal.PlainDateTime(2020, 1, 1, 0, 0, 0); var r = []; ["earlier", "later"].forEach(function (m) { var z = w.toZonedDateTime("-12:00", { disambiguation: m }); var n = String(z.epochNanoseconds); if (z.toPlainDateTime().equals(w) && r.indexOf(n) < 0) r.push(n); }); r.join()
note: row A12, an offset zone; the instants the wall time names, through the two that earlier and later pick (at most two in the data)
since: 21

