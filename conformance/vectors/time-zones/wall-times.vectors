id: time-zones/wall/0071
area: time-zones
op: GetPossibleEpochNanoseconds
in: str:"America/New_York" int:2026 int:7 int:1 int:12 int:0 int:0
out: value: str:"1782921600000000000"
class: normative
prov: spec:es2026@0248456c#sec-time-zone-identifiers spec:es2026@0248456c#sec-getnamedtimezoneepochnanoseconds ref:tzref@1
script: var w = new Temporal.PlainDateTime(2026, 7, 1, 12, 0, 0); var r = []; ["earlier", "later"].forEach(function (m) { var z = w.toZonedDateTime("America/New_York", { disambiguation: m }); var n = String(z.epochNanoseconds); if (z.toPlainDateTime().equals(w) && r.indexOf(n) < 0) r.push(n); }); r.join()
note: rows A3 and A4, an ordinary wall time; the instants the wall time names, through the two that earlier and later pick (at most two in the data)
since: 21

