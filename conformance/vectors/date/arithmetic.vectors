id: date/setter-order/0001
area: date
op: Date.prototype.setUTCHours, order
in: str:"undefined"
out: value: f64:0x0000000000000000
class: normative
prov: spec:es2026@0248456c#sec-date.prototype.setutchours ref:dateref@1
script: var d = new Date(0); var seen = null; d.setUTCHours(undefined, { valueOf: function () { seen = d.getTime(); return 0; } }); seen
note: a later argument's conversion reads the date: it is unchanged until the setter writes it
since: 14

id: date/setter-order/0002
area: date
op: Date.prototype.setUTCHours, order
in: str:"NaN"
out: value: f64:0x0000000000000000
class: normative
prov: spec:es2026@0248456c#sec-date.prototype.setutchours ref:dateref@1
script: var d = new Date(0); var seen = null; d.setUTCHours(NaN, { valueOf: function () { seen = d.getTime(); return 0; } }); seen
