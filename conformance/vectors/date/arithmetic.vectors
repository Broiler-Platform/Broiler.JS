since: 14

id: date/setter-order/0003
area: date
op: Date.prototype.setUTCHours, conversions on an invalid date
in: int:4
out: value: f64:0x4010000000000000
class: normative
prov: spec:es2026@0248456c#sec-date.prototype.setutchours ref:dateref@1 test262:test/built-ins/Date/prototype/setUTCHours/arg-coercion-order.js
script: var n = 0; var v = { valueOf: function () { n++; return 1; } }; new Date(NaN).setUTCHours(v, v, v, v); n
note: every present argument is converted before the invalid date is noticed
since: 14

