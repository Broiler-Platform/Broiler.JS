script: var d = new Date(1637004600000); (Date.UTC(d.getFullYear(), d.getMonth(), d.getDate(), d.getHours(), d.getMinutes(), d.getSeconds(), d.getMilliseconds()) - d.getTime()) / 60000 === -d.getTimezoneOffset()
