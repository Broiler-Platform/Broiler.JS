script: var d = new Date(315538200000); var p = function (n) { return (n < 10 ? "0" : "") + n; }; var m = / ([0-9]{2}):([0-9]{2}):([0-9]{2}) GMT([+-])([0-9]{2})([0-9]{2})/.exec(d.toString()); m[1] + m[2] + m[3] === p(d.getHours()) + p(d.getMinutes()) + p(d.getSeconds()) && (m[4] === "-" ? 1 : -1) * (m[5] * 60 + m[6] * 1) === d.getTimezoneOffset()
note: toString's clock and offset are LocalTime(t)'s and the zone's at t, in every zone with whole-minute offsets, which every zone has after 1979
