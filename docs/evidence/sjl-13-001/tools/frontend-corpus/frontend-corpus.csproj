<Project Sdk="Microsoft.NET.Sdk">
  <!--
    Bundle SJL-13-001's corpus runner for the home rule's part A (docs/evidence/sjl-13-001/decision-rule.md): the
    parse corpus through Broiler.ECMAScript.Frontend in configurations V and J, and the eval-family inputs as eval
    requests under E0 to E7 in configuration V, with the regular-expression provider answering from the classification
    (decision D26). It references the library by relative path, so a build at a commit runs that commit's library, and
    it compiles the probe's parse-corpus reader and the runners' Unicode provider from their files, so its requests are
    the probe's (stage SJL-13.2e). See README.md beside this file.
  -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>disable</ImplicitUsings>
    <IsPackable>false</IsPackable>
    <AssemblyName>frontend-corpus</AssemblyName>
    <RootNamespace>FrontendCorpus</RootNamespace>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <InvariantGlobalization>true</InvariantGlobalization>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="../../../../../Broiler.ECMAScript/Broiler.ECMAScript.Frontend/Broiler.ECMAScript.Frontend.csproj" />
    <PackageReference Include="Broiler.Unicode.Generation" />
  </ItemGroup>
  <ItemGroup>
    <Compile Include="../../../../../Broiler.ECMAScript/Broiler.ECMAScript.Probe/ParseCorpus.cs" Link="ParseCorpus.cs" />
    <Compile Include="../../../../../Broiler.ECMAScript/runners/UnicodeDataHome.cs" Link="UnicodeDataHome.cs" />
  </ItemGroup>
</Project>
