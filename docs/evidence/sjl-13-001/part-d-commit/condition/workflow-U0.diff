@@ -30 +37 @@ concurrency:
-  group: shared-${{ github.workflow }}-${{ github.ref }}-${{ inputs.package-version }}
+  group: shared-${{ github.workflow }}-${{ github.ref }}-${{ inputs.package-version }}${{ github.event_name == 'push' && format('-{0}', github.sha) || '' }}
@@ -111,0 +119,18 @@ jobs:
+      # The JIT publication: the same project and settings with PublishAot off, framework-dependent
+      # and portable (no runtime identifier), into a folder of its own beside the Native AOT
+      # image's. The command is the one bundle sjl-13-001 took locally for its rule's part D but
+      # for that folder, and it is the same on both legs: without a runtime identifier the
+      # publication does not depend on the runner's, and each leg runs it on its own runtime.
+      - name: Publish with the JIT
+        run: |
+          set -o pipefail
+          dotnet publish Broiler.ECMAScript/Broiler.ECMAScript.Probe -c Release -p:PublishAot=false -o Broiler.ECMAScript/Broiler.ECMAScript.Probe/bin/Release/net10.0/jit-publish --nologo 2>&1 | tee probe-publish-jit.log
+          # Warnings are errors already; this states the zero the exit clause asks for.
+          if grep -E "warning [A-Z]+[0-9]+" probe-publish-jit.log; then
+            echo "::error::the JIT publish reported a warning"
+            exit 1
+          fi
+      - name: Run the corpus under the JIT publication, and compare
+        run: |
+          dotnet Broiler.ECMAScript/Broiler.ECMAScript.Probe/bin/Release/net10.0/jit-publish/Broiler.ECMAScript.Probe.dll conformance/vectors --report probe-jit-published.tsv
+          cmp probe-aot.tsv probe-jit-published.tsv
@@ -124,0 +150,2 @@ jobs:
+            probe-publish-jit.log
+            probe-jit-published.tsv
