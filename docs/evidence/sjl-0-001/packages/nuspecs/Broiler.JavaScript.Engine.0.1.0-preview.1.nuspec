<?xml version="1.0" encoding="utf-8"?>
<package xmlns="http://schemas.microsoft.com/packaging/2013/05/nuspec.xsd">
  <metadata>
    <id>Broiler.JavaScript.Engine</id>
    <version>0.1.0-preview.1</version>
    <authors>Broiler contributors</authors>
    <license type="expression">Apache-2.0</license>
    <licenseUrl>https://licenses.nuget.org/Apache-2.0</licenseUrl>
    <icon>icon.png</icon>
    <readme>README.md</readme>
    <projectUrl>https://github.com/Broiler-Platform/Broiler.JS</projectUrl>
    <description>Broiler.JS execution host: JSEngine, JSContext, JavaScriptBootstrap, context builders and profiles, and feature flags. Reference this package to embed the engine.</description>
    <copyright>Copyright (c) Broiler contributors</copyright>
    <tags>broiler javascript ecmascript compiler engine</tags>
    <repository type="git" url="https://github.com/Broiler-Platform/broiler.js" commit="44a214dc5b04a5c8db556dc9b57894beaeb20d0c" />
    <dependencies>
      <group targetFramework="net10.0">
        <dependency id="Broiler.JavaScript.Ast" version="0.1.0-preview.1" exclude="Build,Analyzers" />
        <dependency id="Broiler.JavaScript.Expressions" version="0.1.0-preview.1" exclude="Build,Analyzers" />
        <dependency id="Broiler.JavaScript.Parser" version="0.1.0-preview.1" exclude="Build,Analyzers" />
        <dependency id="Broiler.JavaScript.Runtime" version="0.1.0-preview.1" exclude="Build,Analyzers" />
        <dependency id="Broiler.JavaScript.Storage" version="0.1.0-preview.1" exclude="Build,Analyzers" />
      </group>
    </dependencies>
  </metadata>
</package>