parse-corpus-c: (cd <after checkout> && python3 -I scripts/compliance/compare_parse_corpus.py acceptance --base docs/evidence/sjl-12-001/base/parse-corpus-c.tsv.gz --after docs/evidence/sjl-12-001/after/parse-corpus-c.tsv.gz --manifest conformance/parse/corpus.manifest --changelog Broiler.JS/CHANGELOG.md --output docs/evidence/sjl-12-001/after/parse-corpus-c.json > docs/evidence/sjl-12-001/after/parse-corpus-c.out 2> <logs>/parse-corpus-c.stderr.txt)
parse-corpus-d: (cd <after checkout> && python3 -I scripts/compliance/compare_parse_corpus.py determinism --run1 docs/evidence/sjl-12-001/after/parse-corpus-d1.tsv.gz --run2 docs/evidence/sjl-12-001/after/parse-corpus-d2.tsv.gz --run3 docs/evidence/sjl-12-001/after/parse-corpus-d3.tsv.gz --population docs/evidence/sjl-12-001/after/parse-corpus-c.tsv.gz --manifest conformance/parse/corpus.manifest --require-pass --output docs/evidence/sjl-12-001/after/parse-corpus-d.json > docs/evidence/sjl-12-001/after/parse-corpus-d.out 2> <logs>/parse-corpus-d.stderr.txt)
