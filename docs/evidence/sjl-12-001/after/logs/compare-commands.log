part-d-k2: (cd <after checkout> && python3 -I scripts/compliance/compare_parse_corpus.py determinism --run1 docs/evidence/sjl-12-001/controls/part-d-k2-d1.tsv.gz --run2 docs/evidence/sjl-12-001/controls/part-d-k2-d2.tsv.gz --run3 docs/evidence/sjl-12-001/controls/part-d-k2-d3.tsv.gz --population docs/evidence/sjl-12-001/after/parse-corpus-c.tsv.gz --manifest conformance/parse/corpus.manifest --expect-differ 1:2 --output docs/evidence/sjl-12-001/controls/part-d-k2.json > docs/evidence/sjl-12-001/controls/part-d-k2.out 2> <logs>/part-d-k2.stderr.txt)
