<Project Sdk="Microsoft.NET.Sdk">
  <!-- Bundle sjl-14-001's part F metadata reader (decision-rule.md, part F: "a metadata reader, committed to the bundle,
       listing the [Obsolete] attribute, its diagnostic identifier and its message on every public type of
       Broiler.JavaScript.Ast and Broiler.JavaScript.Parser"). It reads assemblies' metadata with
       System.Reflection.Metadata and loads nothing; it references no project of the repository. -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <IsPackable>false</IsPackable>
  </PropertyGroup>
</Project>
