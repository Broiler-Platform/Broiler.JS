    <UnitTestResult executionId="d39f93f4-6b6d-4351-a19a-efad764f8361" testId="a31a6266-0216-7885-9554-c71c39dc734d" testName="Broiler.HtmlBridge.Tests.FrameScriptExecutionTests.AFramesDeclarationsDoNotLandOnTheContainingPagesWindow" computerName="vm" duration="00:00:00.0010000" startTime="2026-11-23T22:29:13.4386832+00:00" endTime="2026-11-23T22:29:13.4387380+00:00" testType="13cdc9d9-ddb5-4fa4-a97d-d965ccfc6d4b" outcome="NotExecuted" testListId="8c84fa94-04c1-424b-9868-57a2d4851a1d" relativeResultsDirectory="d39f93f4-6b6d-4351-a19a-efad764f8361">
      <Output>
        <ErrorInfo>
          <Message>A frame's scripts are evaluated in the containing page's global object, and under this engine that object IS the page's window, so a frame's top-level var/function becomes a property of the page's own window as well as of the frame's: frames[0].frameGlobal and the page's unqualified frameGlobal are one binding, and two frames declaring the same name overwrite each other. HTML gives every nested browsing context a global object of its own. src/Broiler.HtmlBridge.Dom/DomBridge/SubDocuments.cs:418</Message>
        </ErrorInfo>
      </Output>
    </UnitTestResult>
