<Project Sdk="Microsoft.NET.Sdk">
  <!-- Bundle sjl-14-001, part C at the base commit, a reading aid (records part 4, 2026-11-23): the time, processor time
       and peak memory of one parse of test262's test/staging/sm/regress/regress-610026.js's eval sources, at the old
       parser (P), the shared library alone (L, SyntaxParser.Parse of the bridge's own request) and the bridge (B, the
       library's parse and the tree's construction), each in its own process. Built from a clean tree given as
       -p:Tree=<tree>. No run the rule names. -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <IsPackable>false</IsPackable>
    <AssemblyName>parse-time</AssemblyName>
    <RootNamespace>ParseTime</RootNamespace>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="$(Tree)/Broiler.JS/Broiler.JavaScript.Parser/Broiler.JavaScript.Parser.csproj" />
    <ProjectReference Include="$(Tree)/Broiler.JS/Broiler.JavaScript.Ast/Broiler.JavaScript.Ast.csproj" />
    <ProjectReference Include="$(Tree)/Broiler.ECMAScript/Broiler.ECMAScript.Frontend/Broiler.ECMAScript.Frontend.csproj" />
  </ItemGroup>
</Project>
