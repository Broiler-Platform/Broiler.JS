<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Description>Broiler.JS JavaScript syntax tree: the expression, statement, pattern, and misc AST nodes the parser produces and the compiler consumes, with the Unicode tables and the regular-expression pattern checks the parser and the built-ins share.</Description>
    <LangVersion>latest</LangVersion>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <Nullable>enable</Nullable>
  </PropertyGroup>

  <!-- No package reference since window W2 of milestone SJL-14 (decision D50): the Unicode tables, which read
       Broiler.Unicode.Algorithms, and RegExpUnicodeValidator, which forwards to Broiler.Regex's validate entry, moved to
       Broiler.JavaScript.Expressions with both references (the tables at W2's stage 2, the validator with the other
       non-tree types at its stage 4); this assembly keeps a type forwarder for each public type that moved. The two
       references came here from Broiler.JavaScript.Runtime at milestone SJL-12.5 (Broiler.VM's JSD-0080, decision D20)
       and milestone SJL-11.5 (JSD-0081, decisions D21 and D22). -->

  <ItemGroup>
    <!-- StringSpan's obsolete trims forward to the shared white-space set (milestone SJL-7.5). -->
    <ProjectReference Include="..\..\Broiler.ECMAScript\Broiler.ECMAScript.Algorithms\Broiler.ECMAScript.Algorithms.csproj" />
    <ProjectReference Include="..\Broiler.JavaScript.Expressions\Broiler.JavaScript.Expressions.csproj" />
  </ItemGroup>

  <ItemGroup>
    <!-- The grants that once covered the Unicode tables, which moved to Broiler.JavaScript.Expressions at window W2 of
         milestone SJL-14 (decision D50) with grants of their own: the parser and the built-ins read this assembly's
         internal tree members, and its tests read its internals. The pattern's name checks that were internal here went
         at milestone SJL-11.5. -->
    <InternalsVisibleTo Include="Broiler.JavaScript.Parser" />
    <InternalsVisibleTo Include="Broiler.JavaScript.BuiltIns" />
    <InternalsVisibleTo Include="Broiler.JavaScript.Ast.Tests" />
  </ItemGroup>

  <ItemGroup>
    <!-- The loops' ContainsContinue is internal: the parser records it and the compiler's for-loop pass
         reads it (milestone SJL-12.5, item 5; Broiler.VM's JSD-0080, decision D22). -->
    <InternalsVisibleTo Include="Broiler.JavaScript.Compiler" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Update="Microsoft.CodeAnalysis.BannedApiAnalyzers">
      <IncludeAssets>build; analyzers; buildtransitive</IncludeAssets>
    </PackageReference>
  </ItemGroup>
</Project>
