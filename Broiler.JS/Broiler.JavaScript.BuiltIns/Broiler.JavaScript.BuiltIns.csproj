<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <LangVersion>latest</LangVersion>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <Nullable>enable</Nullable>
  </PropertyGroup>

  <ItemGroup>
    <!-- Bundled IANA time-zone database (generated by scripts/tzdata/generate_tzdata.py)
         so Temporal / Date time-zone behaviour does not depend on the host OS tz data. -->
    <EmbeddedResource Include="Temporal\Tz\tzdata.bin" LogicalName="Broiler.JavaScript.BuiltIns.Temporal.Tz.tzdata.bin" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Broiler.Regex" Version="0.1.0-preview.1" />
    <PackageReference Include="UnicodeCldr.LocaleData" Version="0.1.0-preview.1" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Broiler.JavaScript.LinqExpressions\Broiler.JavaScript.LinqExpressions.csproj" />
    <ProjectReference Include="..\Broiler.JavaScript.Extensions\Broiler.JavaScript.Extensions.csproj" />
    <ProjectReference Include="..\Broiler.JavaScript.JSClassGenerator\Broiler.JavaScript.JSClassGenerator.csproj" ReferenceOutputAssembly="false" OutputItemType="Analyzer" GlobalPropertiesToRemove="PublishTrimmed;PublishAot;PublishReadyToRun;RuntimeIdentifier;SelfContained" />
    <ProjectReference Include="..\Broiler.JavaScript.Engine\Broiler.JavaScript.Engine.csproj" />
  </ItemGroup>

</Project>
