<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Description>Broiler.JS ECMAScript built-ins: Array, Map, Set, Promise, Proxy, RegExp, String, Symbol, typed arrays, and the rest of the standard library objects.</Description>
    <LangVersion>latest</LangVersion>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <Nullable>enable</Nullable>
  </PropertyGroup>

  <ItemGroup>
    <!-- The time data home's tables (milestone SJL-8.6, decision SJL-D-6 (c)): the IANA time zone tables
         (tzdb 2026e, CLDR primaries) and the calendar tables, which Broiler.ECMAScript.Generation writes
         from the home's pins. They are linked from the home, never copied, so that they cannot drift;
         TemporalTimeData hands their bytes to the shared decoders once, on first use. -->
    <EmbeddedResource Include="..\..\Broiler.ECMAScript\data\time\generated\time-zones.bin" Link="Temporal\TimeData\time-zones.bin" LogicalName="Broiler.JavaScript.BuiltIns.TimeData.time-zones.bin" />
    <EmbeddedResource Include="..\..\Broiler.ECMAScript\data\time\generated\time-zone-ids.txt" Link="Temporal\TimeData\time-zone-ids.txt" LogicalName="Broiler.JavaScript.BuiltIns.TimeData.time-zone-ids.txt" />
    <EmbeddedResource Include="..\..\Broiler.ECMAScript\data\time\generated\time-zone-regions.txt" Link="Temporal\TimeData\time-zone-regions.txt" LogicalName="Broiler.JavaScript.BuiltIns.TimeData.time-zone-regions.txt" />
    <EmbeddedResource Include="..\..\Broiler.ECMAScript\data\time\generated\calendars.bin" Link="Temporal\TimeData\calendars.bin" LogicalName="Broiler.JavaScript.BuiltIns.TimeData.calendars.bin" />
    <EmbeddedResource Include="..\..\Broiler.ECMAScript\data\time\generated\tables.manifest" Link="Temporal\TimeData\tables.manifest" LogicalName="Broiler.JavaScript.BuiltIns.TimeData.tables.manifest" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Broiler.Regex" />
    <PackageReference Include="Broiler.Unicode.Cldr.LocaleData" />
    <!-- Intl.Segmenter's boundaries and word statuses (milestone SJL-7.5), over the tables Runtime embeds. -->
    <PackageReference Include="Broiler.Unicode.Segmentation" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\Broiler.ECMAScript\Broiler.ECMAScript.Algorithms\Broiler.ECMAScript.Algorithms.csproj" />
    <ProjectReference Include="..\Broiler.JavaScript.LinqExpressions\Broiler.JavaScript.LinqExpressions.csproj" />
    <ProjectReference Include="..\Broiler.JavaScript.Extensions\Broiler.JavaScript.Extensions.csproj" />
    <ProjectReference Include="..\Broiler.JavaScript.JSClassGenerator\Broiler.JavaScript.JSClassGenerator.csproj" ReferenceOutputAssembly="false" OutputItemType="Analyzer" GlobalPropertiesToRemove="PublishTrimmed;PublishAot;PublishReadyToRun;RuntimeIdentifier;SelfContained" />
    <ProjectReference Include="..\Broiler.JavaScript.Engine\Broiler.JavaScript.Engine.csproj" />
  </ItemGroup>

</Project>
