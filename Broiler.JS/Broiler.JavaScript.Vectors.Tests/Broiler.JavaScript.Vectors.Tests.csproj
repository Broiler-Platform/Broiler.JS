<Project Sdk="Microsoft.NET.Sdk">
  <!--
    This engine's engine-level runner over the shared conformance vectors (milestone SJL-1 of the
    shared JavaScript libraries programme). The corpus lives at conformance/vectors/ in this
    repository and is read from there, never copied into the output. Its reader, validator and the
    report are the shared folder's Broiler.ECMAScript.Conformance library (milestone SJL-2.10),
    and its tests are that folder's; only what runs Broiler.JS is here.
  -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <StartupObject>Broiler.JavaScript.Vectors.Tests.Program</StartupObject>
    <TargetFramework>net10.0</TargetFramework>
    <RootNamespace>Broiler.JavaScript.Vectors.Tests</RootNamespace>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <IsPackable>false</IsPackable>
    <IsTestProject>true</IsTestProject>
    <!-- Program.cs is the entry point: the runner starts this assembly as its evaluating process. -->
    <GenerateProgramFile>false</GenerateProgramFile>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Microsoft.NET.Test.Sdk" />
    <PackageReference Include="xunit.v3" />
    <PackageReference Include="xunit.runner.visualstudio">
      <PrivateAssets>all</PrivateAssets>
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
    </PackageReference>
    <PackageReference Include="coverlet.collector">
      <PrivateAssets>all</PrivateAssets>
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
    </PackageReference>
  </ItemGroup>
  <ItemGroup>
    <!-- The default composition, which the decision rule of bundle sjl-1-001 names. -->
    <ProjectReference Include="..\Broiler.JavaScript.All\Broiler.JavaScript.All.csproj" />
    <ProjectReference Include="..\..\Broiler.ECMAScript\Broiler.ECMAScript.Conformance\Broiler.ECMAScript.Conformance.csproj" />
  </ItemGroup>
  <ItemGroup>
    <Compile Include="..\..\Broiler.ECMAScript\runners\CorpusDirectory.cs" Link="Runners\CorpusDirectory.cs" />
  </ItemGroup>
  <ItemGroup>
    <Using Include="Xunit" />
  </ItemGroup>
</Project>
