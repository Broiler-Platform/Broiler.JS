<Project Sdk="Microsoft.NET.Sdk">
  <!--
    The shared conformance vectors' validator and this engine's runners (milestone SJL-1 of the
    shared JavaScript libraries programme). The corpus lives at conformance/vectors/ in this
    repository and is read from there, never copied into the output.
  -->
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <RootNamespace>Broiler.JavaScript.Vectors.Tests</RootNamespace>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <IsPackable>false</IsPackable>
    <IsTestProject>true</IsTestProject>
    <!-- Program.cs is the entry point: the runner starts this assembly as its evaluating process. -->
    <GenerateProgramFile>false</GenerateProgramFile>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Microsoft.NET.Test.Sdk" />
    <PackageReference Include="xunit" />
    <PackageReference Include="xunit.runner.visualstudio" />
    <PackageReference Include="coverlet.collector" />
  </ItemGroup>
  <ItemGroup>
    <!-- The default composition, which the decision rule of bundle sjl-1-001 names. -->
    <ProjectReference Include="..\Broiler.JavaScript.All\Broiler.JavaScript.All.csproj" />
  </ItemGroup>
  <ItemGroup>
    <Using Include="Xunit" />
  </ItemGroup>
</Project>
