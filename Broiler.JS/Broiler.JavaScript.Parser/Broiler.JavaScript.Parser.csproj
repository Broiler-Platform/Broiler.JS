<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Description>Broiler.JS JavaScript source parsing: FastParser and the parser primitives that produce AST structures.</Description>
    <LangVersion>latest</LangVersion>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
  </PropertyGroup>

  <!-- No reference to Broiler.JavaScript.Runtime (milestone SJL-12.5, Broiler.VM's JSD-0080, decision
       D20): the Unicode tables and the regular-expression checks the parser reads are Ast's, and
       Broiler.Unicode.Algorithms, whose IUnicodeTables types the options' provider, comes with Ast. -->
  <!-- The bridge (milestone SJL-14.2, window W1; Broiler.VM's JSD-0083, decisions D41 and D44) parses with the shared
       syntax library and builds this assembly's tree from the library's. It is internal: the compiler reaches it for
       every compile (window W2, milestone SJL-14.3, which removes SJL-14.2's test-only switch, decision D43), the
       dynamic function's check through BuiltIns, and the tests and bundle sjl-14-001's side-by-side tool (by
       reflection) through the grants below. From W2 every product path loads the library, so it is an ordinary
       reference that flows to every project that references this one, and this assembly's package depends on
       Broiler.ECMAScript.Frontend (decision D30). Until W2 it was a private reference (PrivateAssets="all"), unless a
       build turned the switch on for every compile. -->
  <ItemGroup>
    <ProjectReference Include="..\..\Broiler.ECMAScript\Broiler.ECMAScript.Frontend\Broiler.ECMAScript.Frontend.csproj" />
    <ProjectReference Include="..\..\Broiler.ECMAScript\Broiler.ECMAScript.Algorithms\Broiler.ECMAScript.Algorithms.csproj" />
    <ProjectReference Include="..\Broiler.JavaScript.Ast\Broiler.JavaScript.Ast.csproj" />
    <ProjectReference Include="..\Broiler.JavaScript.Expressions\Broiler.JavaScript.Expressions.csproj" />
  </ItemGroup>
  <!-- Broiler.Regex's validate entry checks a regular-expression literal (milestone SJL-11.5; Broiler.VM's JSD-0081,
       decision D22). Its compile assets stay private here too, as in Ast, so that its namespace does not reach the
       projects that reference the parser. -->
  <ItemGroup>
    <PackageReference Include="Broiler.Regex" PrivateAssets="compile" />
  </ItemGroup>
  <ItemGroup>
    <InternalsVisibleTo Include="Broiler.JavaScript.Compiler" />
    <InternalsVisibleTo Include="Broiler.JavaScript.BuiltIns" />
    <InternalsVisibleTo Include="Broiler.JavaScript.Parser.Tests" />
    <!-- The module analysis reads the shared tree through the bridge's request (window W2, decision D41). -->
    <InternalsVisibleTo Include="Broiler.JavaScript.Modules" />
  </ItemGroup>
  <ItemGroup>
    <PackageReference Update="Microsoft.CodeAnalysis.BannedApiAnalyzers">
      <IncludeAssets>build; analyzers; buildtransitive</IncludeAssets>
    </PackageReference>
  </ItemGroup>
</Project>
