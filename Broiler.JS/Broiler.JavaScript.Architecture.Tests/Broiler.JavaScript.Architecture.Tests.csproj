<Project Sdk="Microsoft.NET.Sdk">
  <!--
    The parser's architecture test (milestone SJL-12, work package SJL-12.5; Broiler.VM's JSD-0080,
    decision D25). It holds the clauses of part B of docs/evidence/sjl-12-001/decision-rule.md over
    the Broiler.JavaScript.Parser assembly and asserts the exact list of the violations the parser
    has today; each later item of SJL-12.5 shrinks the list, until it is empty. There is no rule
    register: the list is the register.

    The metadata clauses read the assembly without loading it, through the shared folder's
    AssemblyFacts, linked rather than copied, and the witness is compiled in memory with Roslyn and
    read the same way. The behavioural fixtures run the parser, so they load the assembly they judge
    into a load context of its own: when BROILER_ARCH_PARSER_ASSEMBLY names another build of the
    parser (the rule commit's, for part B's base), every clause, the fixtures included, judges that
    build. The parser and the runtime are referenced only so that their builds are beside this
    assembly: the parser is the default subject, and the witness names a Runtime type.
  -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <IsPackable>false</IsPackable>
    <IsTestProject>true</IsTestProject>
    <Nullable>enable</Nullable>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Microsoft.NET.Test.Sdk" />
    <PackageReference Include="xunit.v3" />
    <PackageReference Include="xunit.runner.visualstudio">
      <PrivateAssets>all</PrivateAssets>
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
    </PackageReference>
    <PackageReference Include="coverlet.collector">
      <PrivateAssets>all</PrivateAssets>
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
    </PackageReference>
    <PackageReference Include="Microsoft.CodeAnalysis.CSharp" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="..\Broiler.JavaScript.Parser\Broiler.JavaScript.Parser.csproj" />
    <ProjectReference Include="..\Broiler.JavaScript.Runtime\Broiler.JavaScript.Runtime.csproj" />
  </ItemGroup>
  <!-- The host-culture readers' test (HostCultureTests, milestone SJL-9's clause 8, on the owner's ruling of 2026-11-12,
       "Follow-up arch test") compiles each product project's sources in memory against what its build compiles against,
       the other projects' builds among them, and runs the source generator from its build, so every product project of
       the solution and the generator are referenced here, to be built before it runs, and none is referenced as an
       assembly: nothing here calls them, and their types stay out of this project's own compile. -->
  <ItemGroup>
    <ProjectReference Include="..\Broiler.JavaScript\Broiler.JavaScript.csproj" ReferenceOutputAssembly="false" />
    <ProjectReference Include="..\Broiler.JavaScript.All\Broiler.JavaScript.All.csproj" ReferenceOutputAssembly="false" />
    <ProjectReference Include="..\Broiler.JavaScript.Ast\Broiler.JavaScript.Ast.csproj" ReferenceOutputAssembly="false" />
    <ProjectReference Include="..\Broiler.JavaScript.BuiltIns\Broiler.JavaScript.BuiltIns.csproj" ReferenceOutputAssembly="false" />
    <ProjectReference Include="..\Broiler.JavaScript.Clr\Broiler.JavaScript.Clr.csproj" ReferenceOutputAssembly="false" />
    <ProjectReference Include="..\Broiler.JavaScript.Compiler\Broiler.JavaScript.Compiler.csproj" ReferenceOutputAssembly="false" />
    <ProjectReference Include="..\Broiler.JavaScript.Debugger\Broiler.JavaScript.Debugger.csproj" ReferenceOutputAssembly="false" />
    <ProjectReference Include="..\Broiler.JavaScript.Engine\Broiler.JavaScript.Engine.csproj" ReferenceOutputAssembly="false" />
    <ProjectReference Include="..\Broiler.JavaScript.ExpressionCompiler\Broiler.JavaScript.ExpressionCompiler.csproj" ReferenceOutputAssembly="false" />
    <ProjectReference Include="..\Broiler.JavaScript.Expressions\Broiler.JavaScript.Expressions.csproj" ReferenceOutputAssembly="false" />
    <ProjectReference Include="..\Broiler.JavaScript.Extensions\Broiler.JavaScript.Extensions.csproj" ReferenceOutputAssembly="false" />
    <ProjectReference Include="..\Broiler.JavaScript.Globals\Broiler.JavaScript.Globals.csproj" ReferenceOutputAssembly="false" />
    <ProjectReference Include="..\Broiler.JavaScript.LinqExpressions\Broiler.JavaScript.LinqExpressions.csproj" ReferenceOutputAssembly="false" />
    <ProjectReference Include="..\Broiler.JavaScript.Minimal\Broiler.JavaScript.Minimal.csproj" ReferenceOutputAssembly="false" />
    <ProjectReference Include="..\Broiler.JavaScript.ModuleExtensions\Broiler.JavaScript.ModuleExtensions.csproj" ReferenceOutputAssembly="false" />
    <ProjectReference Include="..\Broiler.JavaScript.Modules\Broiler.JavaScript.Modules.csproj" ReferenceOutputAssembly="false" />
    <ProjectReference Include="..\Broiler.JavaScript.Portable\Broiler.JavaScript.Portable.csproj" ReferenceOutputAssembly="false" />
    <ProjectReference Include="..\Broiler.JavaScript.Portable.Compiler\Broiler.JavaScript.Portable.Compiler.csproj" ReferenceOutputAssembly="false" />
    <ProjectReference Include="..\Broiler.JavaScript.Storage\Broiler.JavaScript.Storage.csproj" ReferenceOutputAssembly="false" />
    <ProjectReference Include="..\Broiler.JavaScript.JSClassGenerator\Broiler.JavaScript.JSClassGenerator.csproj" ReferenceOutputAssembly="false" GlobalPropertiesToRemove="PublishTrimmed;PublishAot;PublishReadyToRun;RuntimeIdentifier;SelfContained" />
  </ItemGroup>
  <ItemGroup>
    <Compile Include="..\..\Broiler.ECMAScript\Broiler.ECMAScript.Architecture.Tests\AssemblyFacts.cs" Link="AssemblyFacts.cs" />
    <None Update="witnesses\*.witness" CopyToOutputDirectory="PreserveNewest" />
    <!-- Rule SL2's list, which the test compares with its copy. It is read from the output, not
         found in the checkout, so the test runs wherever the build puts it (an artifacts path
         outside the repository included). -->
    <None Include="..\..\Broiler.ECMAScript\Broiler.ECMAScript.Architecture.Tests\SharedRules.cs" Link="rules\SharedRules.cs" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>
</Project>
