<Project>

  <!-- Import parent Directory.Build.props (repo root) -->
  <Import Project="$([MSBuild]::GetPathOfFileAbove('Directory.Build.props', '$(MSBuildThisFileDirectory)../'))" />

  <PropertyGroup>
    <!-- All Broiler.JavaScript projects target .NET 10.0 -->
    <TargetFramework Condition="'$(TargetFramework)' == ''">net10.0</TargetFramework>
    <LangVersion>latest</LangVersion>
  </PropertyGroup>

  <!-- Milestone SJL-9's clause 8, "Host globalization remains only behind the optional providers", on the owner's ruling
       of 2026-11-11, "Fix all + enforce": the globalization rules CA1304, CA1305, CA1309, CA1310 and CA1311 are errors in
       the engine's product projects (host-culture.globalconfig says why each holds). The scope is every project below
       this folder but the ones that ship no engine code: the test projects (a name ending in "Tests"), the benchmarks,
       the samples (the samples folder and a name ending in "Sample"), the perf tools under OtherTests, and the source
       generator, a netstandard2.0 plug-in that runs in the compiler and that the .NET analyzers do not read. A test
       project is held to nothing here: its answers are pinned by the cultures it sets. -->
  <PropertyGroup>
    <BroilerProjectFolder>$([MSBuild]::MakeRelative('$(MSBuildThisFileDirectory)', '$(MSBuildProjectDirectory)').Replace('\', '/'))</BroilerProjectFolder>
    <BroilerHostCultureRules Condition="'$(BroilerHostCultureRules)' == ''">true</BroilerHostCultureRules>
    <BroilerHostCultureRules Condition="$(MSBuildProjectName.EndsWith('Tests'))">false</BroilerHostCultureRules>
    <BroilerHostCultureRules Condition="$(MSBuildProjectName.EndsWith('Sample'))">false</BroilerHostCultureRules>
    <BroilerHostCultureRules Condition="'$(MSBuildProjectName)' == 'Broiler.JavaScript.JSClassGenerator'">false</BroilerHostCultureRules>
    <BroilerHostCultureRules Condition="$(BroilerProjectFolder.StartsWith('benchmarks/')) Or $(BroilerProjectFolder.StartsWith('samples/')) Or $(BroilerProjectFolder.StartsWith('OtherTests/'))">false</BroilerHostCultureRules>
  </PropertyGroup>
  <ItemGroup Condition="'$(BroilerHostCultureRules)' == 'true'">
    <GlobalAnalyzerConfigFiles Include="$(MSBuildThisFileDirectory)host-culture.globalconfig" />
  </ItemGroup>

  <!-- Milestone SJL-14.2 (decision D43): building with -p:BroilerParseThroughBridge=true turns the compiler's test-only
       switch on for every compile (JSCompilationOptions.BridgeByDefault), so that the test projects run with the
       compiler parsing through the bridge to the shared syntax library, and the bridge's library flows to every project
       (Broiler.JavaScript.Parser.csproj). Without the property nothing changes. Only a property given to the build
       counts: MSBuild reads an environment variable of the same name as a property too, and one set by accident would
       turn the switch on in every shipped assembly without a word, so a build that finds the variable set ignores the
       property and says so. A departure from D43's "set by tests through the internals grant, no environment read",
       recorded in docs/roadmap/SharedLibraries.md (D43's note of 2026-11-03). Window W2 removes it. -->
  <PropertyGroup>
    <BroilerParseThroughBridgeFromEnvironment>$([System.Environment]::GetEnvironmentVariable('BroilerParseThroughBridge'))</BroilerParseThroughBridgeFromEnvironment>
  </PropertyGroup>
  <PropertyGroup Condition="'$(BroilerParseThroughBridge)' == 'true' and '$(BroilerParseThroughBridgeFromEnvironment)' == ''">
    <BroilerBridgeBuild>true</BroilerBridgeBuild>
    <DefineConstants>$(DefineConstants);BROILER_PARSE_THROUGH_BRIDGE</DefineConstants>
  </PropertyGroup>
  <Target Name="BroilerReportBridgeBuild" BeforeTargets="CoreCompile">
    <Message Importance="high" Condition="'$(BroilerBridgeBuild)' == 'true'"
             Text="$(MSBuildProjectName): built with the compiler's test-only switch ON (BroilerParseThroughBridge=true): every compile parses through the bridge. Not a product build." />
    <Message Importance="high" Condition="'$(BroilerParseThroughBridgeFromEnvironment)' != ''"
             Text="$(MSBuildProjectName): the environment variable BroilerParseThroughBridge is set and ignored; the compiler's test-only switch stays off. Pass -p:BroilerParseThroughBridge=true to the build instead." />
  </Target>

</Project>
