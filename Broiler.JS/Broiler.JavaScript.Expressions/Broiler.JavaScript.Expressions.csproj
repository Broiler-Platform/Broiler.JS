<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Description>Broiler.JS backend-neutral expression model: BExpression nodes, converters, and the contracts shared by the JavaScript compiler and its execution back ends.</Description>
	  <LangVersion>latest</LangVersion>
	  <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
  </PropertyGroup>

  <!-- The point of this assembly: it must stay free of System.Reflection.Emit, so the
       trim and AOT analyzers can be pointed at it. The warning count they report is the
       evidence Assemblies.md item A-0 is waiting on. -->
  <PropertyGroup>
    <IsTrimmable>true</IsTrimmable>
    <IsAotCompatible>true</IsAotCompatible>
  </PropertyGroup>

  <!-- The emitted ** calls the shared library's Number::exponentiate, MathKernels.Power (SJL-4.5).
       The library references nothing of the engine (rule SL1), so the model stays the bottom of the
       engine's own graph, and it is AOT- and trim-compatible like this assembly. -->
  <ItemGroup>
    <ProjectReference Include="..\..\Broiler.ECMAScript\Broiler.ECMAScript.Algorithms\Broiler.ECMAScript.Algorithms.csproj" />
  </ItemGroup>

</Project>
