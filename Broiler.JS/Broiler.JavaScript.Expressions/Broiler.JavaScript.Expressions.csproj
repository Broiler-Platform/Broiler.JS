<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Description>Broiler.JS backend-neutral expression model: BExpression nodes, converters, and the contracts shared by the JavaScript compiler and its execution back ends.</Description>
	  <LangVersion>latest</LangVersion>
	  <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
  </PropertyGroup>

  <!-- The point of this assembly: it must stay free of System.Reflection.Emit, so the
       trim and AOT analyzers can be pointed at it. The warning count they report is the
       evidence Assemblies.md item A-0 is waiting on. -->
  <PropertyGroup>
    <IsTrimmable>true</IsTrimmable>
    <IsAotCompatible>true</IsAotCompatible>
  </PropertyGroup>

  <!-- The emitted ** calls the shared library's Number::exponentiate, MathKernels.Power (SJL-4.5).
       The library references nothing of the engine (rule SL1), so the model stays the bottom of the
       engine's own graph, and it is AOT- and trim-compatible like this assembly. -->
  <ItemGroup>
    <ProjectReference Include="..\..\Broiler.ECMAScript\Broiler.ECMAScript.Algorithms\Broiler.ECMAScript.Algorithms.csproj" />
  </ItemGroup>

  <!-- The Unicode area's algorithms (milestone SJL-7.5), over the tables this assembly embeds
       (Unicode/JSUnicodeTableData.g.cs), for the parser, the built-ins and the portable compiler. The tables moved
       here from Broiler.JavaScript.Ast at window W2 of milestone SJL-14 (decision D50: the non-tree types' new home is
       this assembly, and the tables move with their readers), when the portable compiler, which references neither
       Ast nor Parser (decision D53), became one of their readers; they moved to Ast from Broiler.JavaScript.Runtime at
       milestone SJL-12.5 (Broiler.VM's JSD-0080, decision D20). They are internal, as they were there. -->
  <ItemGroup>
    <PackageReference Include="Broiler.Unicode.Algorithms" />
    <!-- Broiler.Regex's validate entry (milestone SJL-11.5; Broiler.VM's JSD-0081, decisions D21 and D22):
         RegExpUnicodeValidator, which moved here from Ast at window W2 (decision D50), forwards to it. Its compile assets
         stay private (PrivateAssets="compile"), as they were in Ast, so that its namespace, Broiler.Regex, does not reach
         the projects that reference this one, where it would hide .NET's Regex inside every namespace under Broiler; its
         runtime assets and the package dependency still flow. -->
    <PackageReference Include="Broiler.Regex" PrivateAssets="compile" />
  </ItemGroup>
  <ItemGroup>
    <PackageReference Update="Microsoft.CodeAnalysis.BannedApiAnalyzers">
      <IncludeAssets>build; analyzers; buildtransitive</IncludeAssets>
    </PackageReference>
  </ItemGroup>

</Project>
