<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Description>Broiler.JS backend-neutral expression model: BExpression nodes, converters, and the contracts shared by the JavaScript compiler and its execution back ends.</Description>
	  <LangVersion>latest</LangVersion>
	  <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
  </PropertyGroup>

  <!-- The point of this assembly: it must stay free of System.Reflection.Emit, so the
       trim and AOT analyzers can be pointed at it. The warning count they report is the
       evidence Assemblies.md item A-0 is waiting on. -->
  <PropertyGroup>
    <IsTrimmable>true</IsTrimmable>
    <IsAotCompatible>true</IsAotCompatible>
  </PropertyGroup>

</Project>
