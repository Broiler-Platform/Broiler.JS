<Project Sdk="Microsoft.NET.Sdk">
  <!-- SL5 witness: a library with every analyzer on that suppresses a trim warning and exempts an AOT
       warning from warnings-as-errors. Convention 12: no trim, AOT or single-file warning is
       suppressed, by NoWarn or otherwise. -->
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>disable</ImplicitUsings>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <Deterministic>true</Deterministic>
    <AllowUnsafeBlocks>false</AllowUnsafeBlocks>
    <IsAotCompatible>true</IsAotCompatible>
    <IsTrimmable>true</IsTrimmable>
    <NoWarn>$(NoWarn);IL2026</NoWarn>
    <WarningsNotAsErrors>IL3050</WarningsNotAsErrors>
  </PropertyGroup>
</Project>
