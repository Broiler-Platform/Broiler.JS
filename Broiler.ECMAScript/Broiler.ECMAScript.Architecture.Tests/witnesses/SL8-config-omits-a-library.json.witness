// SL8 witness: a Hairs configuration (hairs.config.json) that leaves a shared library out of coverage, uses
// the owning component's narrower exemption predicate and permits preprocessor directives. It names the
// artefacts and the regenerateCommand as the shared folder's hairs.config.json does.
// (Changed 2026-11-08, when the owner chose to migrate from Broiler.Code's review CLI to Hairs.Cli
// 0.1.0-preview.2. The first two lines read "SL8 witness: an assurance configuration that leaves a
// shared library out of coverage, uses the" and "owning component's narrower exemption predicate and
// permits preprocessor directives."; the sentence is rewrapped above, and the file had no artefacts
// and no regenerateCommand.)
{
  "schema": 1,
  "component": "Broiler.ECMAScript",
  "projects": [
    "Broiler.ECMAScript.Algorithms/Broiler.ECMAScript.Algorithms.csproj"
  ],
  "exemptionPredicate": "owning-component",
  "forbidDirectives": false,
  "artefacts": {
    "report": "CODE-ASSURANCE.md",
    "humanReview": "HUMAN_REVIEW.md",
    "manifest": "hairs.manifest.json"
  },
  "regenerateCommand": "dotnet tool run hairs -- assurance generate --root Broiler.ECMAScript"
}
