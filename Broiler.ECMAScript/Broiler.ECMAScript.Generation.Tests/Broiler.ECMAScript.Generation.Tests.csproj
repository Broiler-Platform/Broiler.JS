<Project Sdk="Microsoft.NET.Sdk">
  <!--
    The tests of the time data home's generator (milestone SJL-8.2): the home's pins and archives against
    their recorded hashes and against Broiler.VM's pins, the compiler's known histories, the hand-written
    row readers against the regular expressions Broiler.VM's generator used, the source writers against
    Broiler.VM's generated files, and the digests of every generated table. Rule SL7, in the architecture
    tests, regenerates the home's generated area and compares it byte for byte. JIT only: the generator is
    run by tests, never inside an engine.

    Milestone SJL-9.2b adds the Intl data home's tests: its pins against every entry of Broiler.VM's CLDR
    pin, the time home's timezone.json and Broiler.Unicode's UCD entries; the locale lists against decision
    D5; the source writer against Broiler.VM's JsCldrTables.g.cs before its assurance pass, byte for byte;
    the completeness of Broiler.JS's tables (exit clause 3); and decision D21's symbols against CLDR's XML.
  -->
  <PropertyGroup>
    <IsPackable>false</IsPackable>
    <IsTestProject>true</IsTestProject>
    <!-- A test project is not a library the Native AOT probe runs; xunit discovers by reflection. -->
    <IsAotCompatible>false</IsAotCompatible>
    <IsTrimmable>false</IsTrimmable>
    <GenerateDocumentationFile>false</GenerateDocumentationFile>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Microsoft.NET.Test.Sdk" />
    <PackageReference Include="xunit" />
    <PackageReference Include="xunit.runner.visualstudio" />
    <PackageReference Include="coverlet.collector" />
    <!-- The Intl data home's UCD copies are held equal to the owner's pin entries (decision JSD-0082 D12):
         test-only, as Broiler.JavaScript.Ast.Tests references it. -->
    <PackageReference Include="Broiler.Unicode.Generation" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="..\Broiler.ECMAScript.Generation\Broiler.ECMAScript.Generation.csproj" />
  </ItemGroup>
  <ItemGroup>
    <Compile Include="..\runners\TimeDataHome.cs" Link="TimeDataHome.cs" />
    <Compile Include="..\runners\IntlDataHome.cs" Link="IntlDataHome.cs" />
  </ItemGroup>
</Project>
