<Project Sdk="Microsoft.NET.Sdk">
  <!--
    The Native AOT probe of milestone SJL-2.14 and convention 12: an executable published with the
    settings of Broiler.VM's composition roots - Native AOT, full trimming, invariant globalization,
    system resource keys and warnings as errors - that runs the library-level vector runner over
    the whole corpus. It proves that the shared libraries, and the test code that judges them,
    compile into a Native AOT image with no warning and give there the answers they give under the
    JIT. The reference arms stay in the JIT test projects and are never part of it.

    Rule SL5 evaluates these properties; the shared-libraries workflow publishes and runs it on
    every change to the folder. From stage SJL-13.2e it also carries the frontend's limits, fuzzing and determinism
    modes (Program.Main's first argument), which the workflow does not run.
  -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <RootNamespace>Broiler.ECMAScript.Probe</RootNamespace>
    <AssemblyName>Broiler.ECMAScript.Probe</AssemblyName>
    <IsPackable>false</IsPackable>
    <GenerateDocumentationFile>false</GenerateDocumentationFile>
    <PublishAot>true</PublishAot>
    <TrimMode>full</TrimMode>
    <InvariantGlobalization>true</InvariantGlobalization>
    <UseSystemResourceKeys>true</UseSystemResourceKeys>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="..\Broiler.ECMAScript.Algorithms\Broiler.ECMAScript.Algorithms.csproj" />
    <ProjectReference Include="..\Broiler.ECMAScript.Intl\Broiler.ECMAScript.Intl.csproj" />
    <ProjectReference Include="..\Broiler.ECMAScript.Frontend\Broiler.ECMAScript.Frontend.csproj" />
    <ProjectReference Include="..\Broiler.ECMAScript.Conformance\Broiler.ECMAScript.Conformance.csproj" />
    <!-- The runner's Unicode provider for the syntax area: the tables the owner's generator writes from this
         repository's pin, data/unicode/pins/, read from disk as the corpus is (milestone SJL-13.2b). -->
    <PackageReference Include="Broiler.Unicode.Generation" />
  </ItemGroup>
  <ItemGroup>
    <Compile Include="..\runners\CorpusDirectory.cs" Link="CorpusDirectory.cs" />
    <Compile Include="..\runners\AlgorithmsLibrary.cs" Link="AlgorithmsLibrary.cs" />
    <Compile Include="..\runners\AlgorithmsLibrary.Text.cs" Link="AlgorithmsLibrary.Text.cs" />
    <Compile Include="..\runners\AlgorithmsLibrary.Date.cs" Link="AlgorithmsLibrary.Date.cs" />
    <Compile Include="..\runners\AlgorithmsLibrary.TimeZones.cs" Link="AlgorithmsLibrary.TimeZones.cs" />
    <Compile Include="..\runners\AlgorithmsLibrary.Temporal.cs" Link="AlgorithmsLibrary.Temporal.cs" />
    <Compile Include="..\runners\AlgorithmsLibrary.Intl.cs" Link="AlgorithmsLibrary.Intl.cs" />
    <Compile Include="..\runners\AlgorithmsLibrary.IntlValues.cs" Link="AlgorithmsLibrary.IntlValues.cs" />
    <Compile Include="..\runners\AlgorithmsLibrary.IntlNumbers.cs" Link="AlgorithmsLibrary.IntlNumbers.cs" />
    <Compile Include="..\runners\AlgorithmsLibrary.IntlDateTimes.cs" Link="AlgorithmsLibrary.IntlDateTimes.cs" />
    <Compile Include="..\runners\AlgorithmsLibrary.IntlDurations.cs" Link="AlgorithmsLibrary.IntlDurations.cs" />
    <Compile Include="..\runners\AlgorithmsLibrary.Syntax.cs" Link="AlgorithmsLibrary.Syntax.cs" />
    <Compile Include="..\runners\UnicodeDataHome.cs" Link="UnicodeDataHome.cs" />
    <!-- The canonical dump of a parse, for the corpus digest mode that compares the JIT and Native AOT parses (stage
         SJL-13.2e). It reads the tree's children and the token stream, internal to the frontend, which grants this
         probe its internals for it. -->
    <Compile Include="..\runners\SyntaxDump.cs" Link="SyntaxDump.cs" />
    <Compile Include="..\runners\TemporalAdapter.cs" Link="TemporalAdapter.cs" />
    <Compile Include="..\runners\TemporalAdapter.Methods.cs" Link="TemporalAdapter.Methods.cs" />
  </ItemGroup>

  <!--
    BROILER.JS'S INTL TABLES ARE COMPILED INTO THE IMAGE (milestone SJL-9.3f, the plan's task 5.f: "the probe runs the Intl
    vectors with Broiler.JS's generated tables embedded"). Every file of the data home's generated area,
    ../data/intl/generated/, with its manifest, is written before the compiler runs into one C# source in the intermediate
    folder, IntlTables.g.cs, which implements the runner's partial method AlgorithmsLibrary.EmbeddedIntlTable: each text
    table as a UTF-8 string literal and each binary one as a byte array, by its file name. The runner then reads the tables
    from the image and holds each to the length and SHA-256 its manifest records, as it holds them on disk; the test
    projects, which compile no such source, read them from disk. Nothing is read through reflection or a manifest resource
    (rule SL3), and nothing is committed: the source is the build's, regenerated whenever a table changes.

    Under InvariantGlobalization (above) the image, and the JIT build through its runtimeconfig.json, have no culture data;
    the Intl library reads none, so the vectors' answers are the tables' alone.
  -->
  <ItemGroup>
    <IntlTableFile Include="..\data\intl\generated\*" />
  </ItemGroup>
  <UsingTask TaskName="WriteIntlTablesSource" TaskFactory="RoslynCodeTaskFactory" AssemblyFile="$(MSBuildToolsPath)\Microsoft.Build.Tasks.Core.dll">
    <ParameterGroup>
      <Tables ParameterType="Microsoft.Build.Framework.ITaskItem[]" Required="true" />
      <Output ParameterType="System.String" Required="true" />
    </ParameterGroup>
    <Task>
      <Using Namespace="System" />
      <Using Namespace="System.IO" />
      <Using Namespace="System.Linq" />
      <Using Namespace="System.Text" />
      <Code Type="Fragment" Language="cs"><![CDATA[
        var text = new StringBuilder();
        text.Append("// <auto-generated/>\n");
        text.Append("// Broiler.JS's Intl tables, written by the probe's build from Broiler.ECMAScript/data/intl/generated/.\n");
        text.Append("namespace Broiler.ECMAScript.Runners;\n\n");
        text.Append("internal sealed partial class AlgorithmsLibrary\n{\n");
        text.Append("    static partial void EmbeddedIntlTable(string name, ref System.ReadOnlySpan<byte> bytes)\n    {\n");
        text.Append("        switch (name)\n        {\n");
        foreach (var table in Tables.OrderBy(t => Path.GetFileName(t.ItemSpec), StringComparer.Ordinal))
        {
            var name = Path.GetFileName(table.ItemSpec);
            var data = File.ReadAllBytes(table.ItemSpec);
            text.Append("            case \"").Append(name).Append("\":\n                bytes = ");
            if (data.All(b => b == 10 || (b >= 32 && b < 127)))
            {
                text.Append('"');
                foreach (var b in data)
                {
                    if (b == 10)
                        text.Append("\\n");
                    else if (b == 92)
                        text.Append("\\\\");
                    else if (b == 34)
                        text.Append("\\\"");
                    else
                        text.Append((char)b);
                }

                text.Append("\"u8;\n");
            }
            else
            {
                text.Append("new byte[] {");
                foreach (var b in data)
                    text.Append(b).Append(',');
                text.Append("};\n");
            }

            text.Append("                return;\n");
        }

        text.Append("        }\n    }\n}\n");
        Directory.CreateDirectory(Path.GetDirectoryName(Output));
        File.WriteAllText(Output, text.ToString(), new UTF8Encoding(false));
      ]]></Code>
    </Task>
  </UsingTask>
  <!-- The intermediate folder is known only once the SDK's targets have set it, so the source's path is set in a target. -->
  <Target Name="NameIntlTablesSource">
    <PropertyGroup>
      <IntlTablesSource>$([System.IO.Path]::Combine('$(ProjectDir)', '$(IntermediateOutputPath)', 'IntlTables.g.cs'))</IntlTablesSource>
    </PropertyGroup>
  </Target>
  <Target Name="WriteIntlTablesSource" BeforeTargets="CoreCompile" DependsOnTargets="NameIntlTablesSource" Inputs="@(IntlTableFile);$(MSBuildProjectFullPath)" Outputs="$(IntlTablesSource)">
    <WriteIntlTablesSource Tables="@(IntlTableFile)" Output="$(IntlTablesSource)" />
  </Target>
  <Target Name="CompileIntlTablesSource" BeforeTargets="CoreCompile" AfterTargets="WriteIntlTablesSource" DependsOnTargets="NameIntlTablesSource">
    <ItemGroup>
      <Compile Include="$(IntlTablesSource)" />
      <FileWrites Include="$(IntlTablesSource)" />
    </ItemGroup>
  </Target>
</Project>
