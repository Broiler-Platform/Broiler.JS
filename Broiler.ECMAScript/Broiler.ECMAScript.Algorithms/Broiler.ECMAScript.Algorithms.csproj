<Project Sdk="Microsoft.NET.Sdk">
  <!--
    The language algorithms library of the shared JavaScript libraries programme: number
    conversion, numerics, text, Date, the Temporal core and the time-zone algorithms, data-free,
    referencing the base class library only (architecture section 2).

    AT THIS VERSION IT HOLDS THE CONTRACT TYPES ONLY - the metering delegate, the status
    enumeration and the limit records of the contract conventions - and no algorithm. It is the
    probe package of milestone SJL-2.13, packed as a pre-release that reaches Broiler.VM through
    its committed feed and is never published to nuget.org. Milestone SJL-3 moves the first
    algorithms in.
  -->
  <PropertyGroup>
    <RootNamespace>Broiler.ECMAScript</RootNamespace>
    <AssemblyName>Broiler.ECMAScript.Algorithms</AssemblyName>
    <PackageId>Broiler.ECMAScript.Algorithms</PackageId>
    <Description>The language algorithms shared by the Broiler JavaScript engines. This version holds the contract types only: the WorkCharge metering delegate, the ResultStatus enumeration and the limit records every shared operation uses.</Description>
    <EnablePackageValidation>true</EnablePackageValidation>
  </PropertyGroup>
</Project>
