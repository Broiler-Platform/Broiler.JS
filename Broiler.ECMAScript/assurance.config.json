// The shared JavaScript libraries are their own assurance component (convention 18; decision SJL-D-5 (a)):
// every relevant declaration of every shared library carries an annotation, the artefacts beside this file
// are generated, and CI fails on drift from the folder's first commit. Rule SL8 holds this file to the
// libraries: a library missing from "projects" fails it.
//
// The strict exemption predicate and the prohibition of preprocessor directives are Broiler.VM's own
// settings (rule J6), because code moves between the two repositories; criteria below High are refused
// because the rubric writes none there.
//
// The one override is fdlibm's (expm1 and log1p, milestone SJL-4.3), whose notice its file keeps under the header.
//
// regenerateCommand assumes the aggregate layout CI reproduces: Broiler.Code and Broiler.JS checked out side
// by side.
{
  "schema": 1,
  "component": "Broiler.ECMAScript",
  "projects": [
    "Broiler.ECMAScript.Algorithms/Broiler.ECMAScript.Algorithms.csproj",
    "Broiler.ECMAScript.Conformance/Broiler.ECMAScript.Conformance.csproj",
    "Broiler.ECMAScript.Generation/Broiler.ECMAScript.Generation.csproj",
    "Broiler.ECMAScript.Intl/Broiler.ECMAScript.Intl.csproj"
  ],
  "exemptionPredicate": "strict",
  "forbidDirectives": true,
  "criteriaBelowHigh": "refused",
  "exclude": [],
  "spdx": {
    "copyright": [
      "2026 Broiler Platform contributors"
    ],
    "license": "Apache-2.0"
  },
  "spdxOverrides": [
    { "glob": "Broiler.ECMAScript.Algorithms/Numbers/Fdlibm.cs",
      "copyright": [ "2026 Broiler Platform contributors", "1993 Sun Microsystems, Inc." ],
      "license": "Apache-2.0 AND SunPro" }
  ],
  "regenerateCommand": "dotnet run --project Broiler.Code/src/Broiler.Code.Review.Cli -c Release -- assurance generate --root Broiler.JS/Broiler.ECMAScript"
}
