<Project Sdk="Microsoft.NET.Sdk">
  <!--
    The tests of the shared syntax library (milestone SJL-13.2; Broiler.VM's JSD-0083). At stage SJL-13.2a: the request's
    defaults for each goal and the preconditions it refuses, the limits and their constants, the providers' shapes, the
    diagnostics' forms, and the parse entry's answer for every goal. At stage SJL-13.2b: the tokenizer, production by
    production, and the parse entry's lexical answer. At stage SJL-13.2c: the parser, production by production, the
    correspondence's rows P, cover grammars, automatic semicolon insertion, the limits and the tree's spans. At stage
    SJL-13.2e: the limits on the documented stack (the deep-nesting corpus, the left-operand charge, each recursive
    construct at the supported maximum) and determinism over the parse corpus's stored inputs. Each later
    stage adds its own. JIT only: the Native
    AOT probe runs the vectors, not these.
  -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <IsPackable>false</IsPackable>
    <IsTestProject>true</IsTestProject>
    <!-- A test project is not a library the Native AOT probe runs; xunit discovers by reflection. -->
    <IsAotCompatible>false</IsAotCompatible>
    <IsTrimmable>false</IsTrimmable>
    <GenerateDocumentationFile>false</GenerateDocumentationFile>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Microsoft.NET.Test.Sdk" />
    <PackageReference Include="xunit.v3" />
    <PackageReference Include="xunit.runner.visualstudio">
      <PrivateAssets>all</PrivateAssets>
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
    </PackageReference>
    <PackageReference Include="coverlet.collector">
      <PrivateAssets>all</PrivateAssets>
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
    </PackageReference>
  </ItemGroup>
  <ItemGroup>
    <!-- The tokenizer's tests read Broiler.Unicode's classes over the tables the owner's generator writes from this
         repository's pin (stage SJL-13.2b), as the library-level runner does. -->
    <PackageReference Include="Broiler.Unicode.Generation" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="..\Broiler.ECMAScript.Frontend\Broiler.ECMAScript.Frontend.csproj" />
  </ItemGroup>
  <ItemGroup>
    <Compile Include="..\runners\UnicodeDataHome.cs" Link="UnicodeDataHome.cs" />
    <Compile Include="..\runners\SyntaxDump.cs" Link="SyntaxDump.cs" />
    <!-- The probe's corpus reader and its digest mode's request and line (SJL-15.2 stage 8), for the tests that hold the
         digest mode's copy of the request equal to the reader's and its lines to their classes (CorpusDigestTests). -->
    <Compile Include="..\Broiler.ECMAScript.Probe\ParseCorpus.cs" Link="ParseCorpus.cs" />
    <Compile Include="..\Broiler.ECMAScript.Probe\CorpusDigestRequest.cs" Link="CorpusDigestRequest.cs" />
  </ItemGroup>
</Project>
