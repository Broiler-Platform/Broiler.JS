# The shared conformance vectors use LF line endings by their schema (conformance/vectors/SCHEMA.md,
# section 1), and the validator refuses a line that ends in CR. A checkout that converted them to
# CRLF - Git for Windows' default, core.autocrlf=true - would make every vector file unreadable, and
# the generator's test compares the committed corpus with what it writes byte for byte. So the corpus
# and its generator's inputs are checked out with LF everywhere.
conformance/** text eol=lf
scripts/conformance/** text eol=lf

# The shared JavaScript libraries (Broiler.ECMAScript/, milestone SJL-2.10) are stored with LF line
# endings everywhere: code may move between this repository and Broiler.VM, whose rule J6 and whose
# assurance fingerprints read the text as stored, and the shared rule SL10 refuses a CR. The engine's
# own folders keep whatever they have; some of them are CRLF or mixed today.
Broiler.ECMAScript/** text eol=lf
Broiler.ECMAScript.slnf text eol=lf
# Rule SL10's witness for CRLF line endings must keep its CRs, so it alone is stored as-is.
Broiler.ECMAScript/Broiler.ECMAScript.Architecture.Tests/witnesses/SL10-crlf-line-endings.cs.witness -text
